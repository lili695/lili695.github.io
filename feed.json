（）@:%_\\+.~#?&amp;//=]&#123;3&#125;[.]js)&#x27;</span><br><span class=\"line\">  - =\\s&#123;0,6&#125;[&quot;,&#x27;,’,”]&#123;0,1&#125;\\s&#123;0,6&#125;(/&#123;0,1&#125;[-a-zA-Z0-9（）@:%_\\+.~#?&amp;//=]&#123;2,100&#125;?[-a-zA-Z0-9（）@:%_\\+.~#?&amp;//=]&#123;3&#125;[.]js)</span><br><span class=\"line\"></span><br><span class=\"line\">dangerousPath:</span><br><span class=\"line\">  - logout</span><br><span class=\"line\">  - update</span><br><span class=\"line\">  - remove</span><br><span class=\"line\">  - insert</span><br><span class=\"line\">  - delete</span><br><span class=\"line\"></span><br><span class=\"line\">rules:</span><br><span class=\"line\">  - name: Swagger</span><br><span class=\"line\">    regex: \\b[\\w/]+?((swagger-ui.html)|(\\&quot;swagger\\&quot;:)|(Swagger UI)|(swaggerUi)|(swaggerVersion))\\b</span><br><span class=\"line\">    loaded: true</span><br><span class=\"line\">  - name: ID Card</span><br><span class=\"line\">    regex: \\b((\\d&#123;8&#125;(0\\d|10|11|12)([0-2]\\d|30|31)\\d&#123;3&#125;)|(\\d&#123;6&#125;(18|19|20)\\d&#123;2&#125;(0[1-9]|10|11|12)([0-2]\\d|30|31)\\d&#123;3&#125;(\\d|X|x)))\\b</span><br><span class=\"line\">    loaded: true</span><br><span class=\"line\">  - name: Phone</span><br><span class=\"line\">    regex: &quot;[&#x27;\\&quot;](1(3([0-35-9]\\\\d|4[1-8])|4[14-9]\\\\d|5([\\\\d]\\\\d|7[1-79])|66\\\\d|7[2-35-8]\\\\d|8\\\\d&#123;2&#125;|9[89]\\\\d)\\\\d&#123;7&#125;)[&#x27;\\&quot;]&quot;</span><br><span class=\"line\">    loaded: true</span><br><span class=\"line\">  - name: JS Map</span><br><span class=\"line\">    regex: \\b([\\w/]+?\\.js\\.map)</span><br><span class=\"line\">    loaded: true</span><br><span class=\"line\">  - name: URL as a Value</span><br><span class=\"line\">    regex: (\\b\\w+?=(https?)(://|%3a%2f%2f))</span><br><span class=\"line\">    loaded: false</span><br><span class=\"line\">  - name: Email</span><br><span class=\"line\">    regex: &quot;[&#x27;\\&quot;]([\\\\w]+(?:\\\\.[\\\\w]+)*@(?:[\\\\w](?:[\\\\w-]*[\\\\w])?\\\\.)+[\\\\w](?:[\\\\w-]*[\\\\w])?)[&#x27;\\&quot;]&quot;</span><br><span class=\"line\">    loaded: true</span><br><span class=\"line\">  - name: Internal IP</span><br><span class=\"line\">    regex: &#x27;[^0-9]((127\\.0\\.0\\.1)|(10\\.\\d&#123;1,3&#125;\\.\\d&#123;1,3&#125;\\.\\d&#123;1,3&#125;)|(172\\.((1[6-9])|(2\\d)|(3[01]))\\.\\d&#123;1,3&#125;\\.\\d&#123;1,3&#125;)|(192\\.168\\.\\d&#123;1,3&#125;\\.\\d&#123;1,3&#125;))&#x27;</span><br><span class=\"line\">    loaded: true</span><br><span class=\"line\">  - name: Cloud Key</span><br><span class=\"line\">    regex: \\b((accesskeyid)|(accesskeysecret)|\\b(LTAI[a-z0-9]&#123;12,20&#125;))\\b</span><br><span class=\"line\">    loaded: true</span><br><span class=\"line\">  - name: Shiro</span><br><span class=\"line\">    regex: (=deleteMe|rememberMe=)</span><br><span class=\"line\">    loaded: true</span><br><span class=\"line\">  - name: Suspicious API Key</span><br><span class=\"line\">    regex: &quot;[\\&quot;&#x27;][0-9a-zA-Z]&#123;32&#125;[&#x27;\\&quot;]&quot;</span><br><span class=\"line\">    loaded: true</span><br><span class=\"line\">  - name: Jwt</span><br><span class=\"line\">    regex: &quot;[&#x27;\\&quot;](ey[A-Za-z0-9_-]&#123;10,&#125;\\\\.[A-Za-z0-9._-]&#123;10,&#125;|ey[A-Za-z0-9_\\\\/+-]&#123;10,&#125;\\\\.[A-Za-z0-9._\\\\/+-]&#123;10,&#125;)[&#x27;\\&quot;]&quot;</span><br><span class=\"line\">    loaded: true</span><br></pre></td></tr></table></figure>\n<figure class=\"highlight javascript\"><table><tr><td class=\"gutter\"><pre><span class=\"line\">1</span><br></pre></td><td class=\"code\"><pre><span class=\"line\"><span class=\"attr\">https</span>:<span class=\"comment\">//github.com/PadishahIII/SecretScrape</span></span><br></pre></td></tr></table></figure>\n",
