;0,1&amp;#125;[-a-zA-Z0-9（）@:%_\+.~#?&amp;amp;//=]&amp;#123;2,100&amp;#125;?[-a-zA-Z0-9（）@:%_\+.~#?&amp;amp;//=]&amp;#123;3&amp;#125;[.]js)&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;dangerousPath:&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;  - logout&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;  - update&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;  - remove&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;  - insert&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;  - delete&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;rules:&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;  - name: Swagger&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    regex: \b[\w/]+?((swagger-ui.html)|(\&amp;quot;swagger\&amp;quot;:)|(Swagger UI)|(swaggerUi)|(swaggerVersion))\b&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    loaded: true&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;  - name: ID Card&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    regex: \b((\d&amp;#123;8&amp;#125;(0\d|10|11|12)([0-2]\d|30|31)\d&amp;#123;3&amp;#125;)|(\d&amp;#123;6&amp;#125;(18|19|20)\d&amp;#123;2&amp;#125;(0[1-9]|10|11|12)([0-2]\d|30|31)\d&amp;#123;3&amp;#125;(\d|X|x)))\b&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    loaded: true&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;  - name: Phone&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    regex: &amp;quot;[&amp;#x27;\&amp;quot;](1(3([0-35-9]\\d|4[1-8])|4[14-9]\\d|5([\\d]\\d|7[1-79])|66\\d|7[2-35-8]\\d|8\\d&amp;#123;2&amp;#125;|9[89]\\d)\\d&amp;#123;7&amp;#125;)[&amp;#x27;\&amp;quot;]&amp;quot;&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    loaded: true&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;  - name: JS Map&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    regex: \b([\w/]+?\.js\.map)&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    loaded: true&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;  - name: URL as a Value&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    regex: (\b\w+?=(https?)(://|%3a%2f%2f))&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    loaded: false&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;  - name: Email&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    regex: &amp;quot;[&amp;#x27;\&amp;quot;]([\\w]+(?:\\.[\\w]+)*@(?:[\\w](?:[\\w-]*[\\w])?\\.)+[\\w](?:[\\w-]*[\\w])?)[&amp;#x27;\&amp;quot;]&amp;quot;&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    loaded: true&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;  - name: Internal IP&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    regex: &amp;#x27;[^0-9]((127\.0\.0\.1)|(10\.\d&amp;#123;1,3&amp;#125;\.\d&amp;#123;1,3&amp;#125;\.\d&amp;#123;1,3&amp;#125;)|(172\.((1[6-9])|(2\d)|(3[01]))\.\d&amp;#123;1,3&amp;#125;\.\d&amp;#123;1,3&amp;#125;)|(192\.168\.\d&amp;#123;1,3&amp;#125;\.\d&amp;#123;1,3&amp;#125;))&amp;#x27;&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    loaded: true&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;  - name: Cloud Key&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    regex: \b((accesskeyid)|(accesskeysecret)|\b(LTAI[a-z0-9]&amp;#123;12,20&amp;#125;))\b&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    loaded: true&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;  - name: Shiro&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    regex: (=deleteMe|rememberMe=)&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    loaded: true&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;  - name: Suspicious API Key&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    regex: &amp;quot;[\&amp;quot;&amp;#x27;][0-9a-zA-Z]&amp;#123;32&amp;#125;[&amp;#x27;\&amp;quot;]&amp;quot;&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    loaded: true&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;  - name: Jwt&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    regex: &amp;quot;[&amp;#x27;\&amp;quot;](ey[A-Za-z0-9_-]&amp;#123;10,&amp;#125;\\.[A-Za-z0-9._-]&amp;#123;10,&amp;#125;|ey[A-Za-z0-9_\\/+-]&amp;#123;10,&amp;#125;\\.[A-Za-z0-9._\\/+-]&amp;#123;10,&amp;#125;)[&amp;#x27;\&amp;quot;]&amp;quot;&lt;/span&gt;&lt;br&gt;&lt;span class=&#34;line&#34;&gt;    loaded: true&lt;/span&gt;&lt;br&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/figure&gt;
&lt;figure class=&#34;highlight javascript&#34;&gt;&lt;table&gt;&lt;tr&gt;&lt;td class=&#34;gutter&#34;&gt;&lt;pre&gt;&lt;span class=&#34;line&#34;&gt;1&lt;/span&gt;&lt;br&gt;&lt;/pre&gt;&lt;/td&gt;&lt;td class=&#34;code&#34;&gt;&lt;pre&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;attr&#34;&gt;https&lt;/span&gt;:&lt;span class=&#34;comment&#34;&gt;//github.com/PadishahIII/SecretScrape&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/figure&gt;
</content>
